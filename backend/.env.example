# WolfTrace Backend - Example environment configuration
# Copy this file to .env and adjust values. Do not commit .env (it is gitignored).

# Server
PORT=5000

# Database backend: "memory" (default) or "neo4j"
# Set to "neo4j" to persist the graph to Neo4j at DB_URI
DB_BACKEND=neo4j

# Neo4j (used when DB_BACKEND=neo4j)
DB_URI=neo4j://127.0.0.1:7687
DB_USERNAME=neo4j
DB_PASSWORD=luna

# Optional Neo4j pool settings
# DB_POOL_SIZE=10
# DB_MAX_CONN_LIFETIME=3600
# DB_ACQUIRE_TIMEOUT=30
# DB_MAX_RETRY_TIME=15

# Logging
LOG_LEVEL=INFO
# LOG_JSON=true
